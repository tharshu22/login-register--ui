{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "cd my-react-app && npm install && npm run build",
    "outputDirectory": "my-react-app/dist",
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "/api"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }